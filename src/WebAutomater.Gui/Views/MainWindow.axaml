<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WebAutomater.Gui.ViewModels"
        xmlns:views="using:WebAutomater.Gui.Views"
        xmlns:local="using:WebAutomater.Gui"
        x:Class="WebAutomater.Gui.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{Binding WindowTitle}"
        Width="1400" Height="860" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <!-- Sekmeler TabStrip + Panel ile kuruldu: görünümler ağaçtan çıkmadığı için sekme değişince
       kaydırma konumu, seçim ve PDF önbelleği korunur. Yeni sekme = bir TabStripItem + bir görünüm. -->
  <Panel>
  <DockPanel>
    <TabStrip DockPanel.Dock="Top" SelectedIndex="{Binding SelectedTabIndex}" Margin="8,2,8,0">
      <TabStripItem Content="Web Otomasyon" FontSize="15" />
      <TabStripItem Content="Belge Tarama" FontSize="15" />
    </TabStrip>
    <Panel>
      <views:WebAutomationView DataContext="{Binding Automation}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsAutomationTab}" />
      <views:DocumentsView DataContext="{Binding Documents}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsDocumentsTab}" />
    </Panel>
  </DockPanel>

  <!-- Hata bildirimleri: işlem yarıda kalsa da uygulama çalışır; ayrıntı günlük dosyasında. -->
  <ItemsControl ItemsSource="{Binding Notices}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,16" Width="380" IsVisible="{Binding HasNotices}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Spacing="8" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="local:ErrorNotice">
        <Border Background="#FFFDECEA" BorderBrush="#E53935" BorderThickness="1" CornerRadius="6" Padding="10,8"
                BoxShadow="0 2 8 0 #40000000">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Text="{Binding Area, StringFormat='Hata · {0}'}" FontWeight="SemiBold" Foreground="#B71C1C" />
            <Button Grid.Column="1" Content="✕" Padding="6,0" Background="Transparent" Foreground="#B71C1C"
                    Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).DismissNoticeCommand}" CommandParameter="{Binding}" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="#3E2723"
                       Margin="0,4,0,0" MaxHeight="120" TextTrimming="CharacterEllipsis" />
            <Button Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Left" Content="Günlük klasörünü aç" Padding="0" Margin="0,6,0,0"
                    Background="Transparent" Foreground="#1565C0" FontSize="12"
                    Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).OpenLogFolderCommand}" />
          </Grid>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
  </Panel>
</Window>
