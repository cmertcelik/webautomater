<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WebAutomater.Gui.ViewModels"
             xmlns:views="using:WebAutomater.Gui.Views"
             x:Class="WebAutomater.Gui.Views.DocumentsView"
             x:DataType="vm:DocumentsViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.excel-status">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="#43A047" />
    </Style>
    <Style Selector="TextBlock.excel-status.error">
      <Setter Property="Foreground" Value="#E53935" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="Margin" Value="0,8,0,3" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chevron">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#1E88E5" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.tree > ListBoxItem">
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Border.tree-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Border.tree-row.drop">
      <Setter Property="Background" Value="#661E88E5" />
      <Setter Property="BorderBrush" Value="#1E88E5" />
    </Style>
    <Style Selector="TextBlock.drop-hint">
      <Setter Property="Foreground" Value="#1E88E5" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.drop-hint.invalid">
      <Setter Property="Foreground" Value="#E53935" />
    </Style>
    <Style Selector="Border.droproot">
      <Setter Property="BorderBrush" Value="#1E88E5" />
      <Setter Property="Background" Value="#221E88E5" />
    </Style>
    <Style Selector="Border.field-editor">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.multiline">
      <Setter Property="MinHeight" Value="80" />
    </Style>
    <Style Selector="ListBox.ids > ListBoxItem">
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <!-- Numara panelinin altındaki sorgu butonu ve ⚙ ayarı. -->
    <DataTemplate DataType="vm:QueryConfigViewModel">
      <Grid ColumnDefinitions="*,4,Auto">
        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{Binding ButtonText}"
                Command="{Binding $parent[views:DocumentsView].((vm:DocumentsViewModel)DataContext).RunQueryCommand}"
                CommandParameter="{Binding}" ToolTip.Tip="{Binding ButtonTip}" ToolTip.ShowOnDisabled="True" />
        <Button Grid.Column="2" Classes="icon" Content="⚙" ToolTip.Tip="İsteği ayarla">
          <Button.Flyout>
            <Flyout Placement="LeftEdgeAlignedBottom">
              <StackPanel Width="560" Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding SettingsTitle}" Classes="title" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="small" Content="Temizle" Command="{Binding ClearCommand}" />
                </Grid>
                <TextBlock Classes="hint"
                           Text="Chrome'da F12 > Network sekmesinde sorgu isteğine sağ tıklayın, Copy > Copy as cURL (bash ya da cmd) veya Copy as fetch seçip buraya yapıştırın. Sonra numaranın geçtiği yeri {id} yazarak değiştirin (ör. ...?tcKimlikNo={id} ya da &quot;vkn&quot;:&quot;{id}&quot;). Her numara için {id} yerine o numara konup istek gönderilir." />
                <TextBox Text="{Binding RequestText}" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                         Height="240" FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12"
                         Watermark="curl 'https://.../sorgu?tc={id}' -H 'cookie: ...'" />
                <TextBlock Text="{Binding Summary}" Classes="hint" Foreground="#43A047" Opacity="1" IsVisible="{Binding HasSummary}" />
                <TextBlock Text="{Binding Error}" Classes="hint" Foreground="#E53935" Opacity="1" IsVisible="{Binding HasError}" />
                <TextBlock Text="{Binding Warnings}" Classes="hint" Foreground="#EF6C00" Opacity="1" IsVisible="{Binding HasWarnings}" />
                <TextBlock Classes="hint"
                           Text="İstek çerez ve oturum bilgisi içerebilir; bu bilgisayardaki ayar dosyasında saklanır. Oturum süresi dolunca istek hata verir: Chrome'dan yeniden kopyalayın." />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid ColumnDefinitions="270,5,*,5,240,5,290">

    <!-- 1. Dosya ağacı -->
    <Border Classes="panel">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
          <TextBlock Text="Dosyalar" Classes="title" />
          <Grid ColumnDefinitions="*,6,Auto,6,Auto">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Klasör seç..." Command="{Binding ChooseFolderCommand}" />
            <Button Name="NewFolderButton" Grid.Column="2" Content="Yeni klasör" IsEnabled="{Binding HasRoot}"
                    ToolTip.Tip="Seçili klasörün içinde yeni klasör oluştur">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Width="260" Spacing="6">
                    <TextBlock Text="Yeni klasör" Classes="title" />
                    <TextBlock Classes="hint" Text="{Binding NewFolderLocation, StringFormat='Konum: {0}'}" TextTrimming="PathSegmentEllipsis"
                               TextWrapping="NoWrap" ToolTip.Tip="{Binding NewFolderLocation}" />
                    <TextBox Name="NewFolderBox" Text="{Binding NewFolderName}" />
                    <TextBlock Text="{Binding NewFolderError}" Classes="hint" Foreground="#E53935" Opacity="1"
                               IsVisible="{Binding NewFolderError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Button Name="CreateFolderButton" Classes="primary" HorizontalAlignment="Right" Content="Oluştur" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Grid.Column="4" Content="Yenile" Command="{Binding RefreshTreeCommand}" IsEnabled="{Binding HasRoot}" />
          </Grid>
          <Grid ColumnDefinitions="*,6,Auto">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{Binding AutoGroupText}"
                    Command="{Binding AutoGroupCommand}" ToolTip.Tip="{Binding AutoGroupTip}" />
            <Button Grid.Column="2" Content="{Binding TagsButtonText}" ToolTip.Tip="Etiketleri ve aranacak kelimeleri ayarla">
              <Button.Flyout>
                <Flyout Placement="RightEdgeAlignedTop">
                  <ScrollViewer MaxHeight="560" Width="380">
                    <StackPanel Spacing="6" Margin="0,0,12,0">
                      <TextBlock Text="Etiketler" Classes="title" />
                      <TextBlock Classes="hint"
                                 Text="Otomatik grupla önce adında aynı dosya numarası geçen dosyaları numara klasöründe toplar (34765). Sonra bu dosyaların içinde aşağıdaki kelimeleri arar; bulunan etiket klasör adına eklenir (34765-vesayet). Kelimeleri virgülle ayırın; büyük/küçük harf ve Türkçe karakter farkı gözetilmez, ekli halleri de bulunur (iflas → iflasın)." />
                      <TextBlock Classes="hint"
                                 Text="Birden çok etiket bulunursa hepsi listedeki sırayla eklenir (34765-vesayet-iflas)." />
                      <TextBlock Classes="hint" Margin="0,4,0,0" IsVisible="{Binding HasNoTags}"
                                 Text="Henüz etiket yok. Etiket olmadan da aynı dosya numaralı dosyalar gruplanır." />
                      <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GroupTagViewModel">
                            <Border Classes="field-editor">
                              <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,2,Auto,2,Auto,2,Auto">
                                  <TextBox Text="{Binding Name}" Watermark="Etiket / klasör adı (ör. İflas)" />
                                  <Button Grid.Column="2" Classes="icon" Content="▲" ToolTip.Tip="Önceliği artır"
                                          Command="{Binding $parent[ItemsControl].((vm:DocumentsViewModel)DataContext).MoveTagUpCommand}" CommandParameter="{Binding}" />
                                  <Button Grid.Column="4" Classes="icon" Content="▼" ToolTip.Tip="Önceliği azalt"
                                          Command="{Binding $parent[ItemsControl].((vm:DocumentsViewModel)DataContext).MoveTagDownCommand}" CommandParameter="{Binding}" />
                                  <Button Grid.Column="6" Classes="icon" Content="✕" ToolTip.Tip="Etiketi sil"
                                          Command="{Binding $parent[ItemsControl].((vm:DocumentsViewModel)DataContext).RemoveTagCommand}" CommandParameter="{Binding}" />
                                </Grid>
                                <TextBox Text="{Binding KeywordsText}" AcceptsReturn="False" TextWrapping="Wrap" MinHeight="50"
                                         Watermark="Aranacak kelimeler: iflas kararı, iflasın açılması" />
                                <TextBlock Text="{Binding Error}" Classes="hint" Foreground="#E53935" Opacity="1" IsVisible="{Binding HasError}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="+ Etiket ekle" Command="{Binding AddTagCommand}" />

                      <TextBlock Text="Dosya numarası" Classes="label" Margin="0,10,0,0" />
                      <TextBlock Classes="hint"
                                 Text="Adında aynı numara geçen dosyalar (ör. 35476 karar.pdf, 35476 tebligat.pdf) aynı konuya ait sayılır ve numara klasöründe toplanır; birinin içinde etiket kelimesi geçmesi klasörün etiketlenmesine yeter. Sonradan gelen dosyalar var olan klasöre (35476 ya da 35476-vesayet) eklenir; etiketi yazılmış klasörlerde yalnızca yeni dosyalar taranır." />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Value="{Binding CaseMinDigits}" Minimum="1" Maximum="20" Increment="1" FormatString="0" Width="110" />
                        <TextBlock Text="–" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding CaseMaxDigits}" Minimum="1" Maximum="20" Increment="1" FormatString="0" Width="110" />
                        <TextBlock Text="haneli sayılar" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Classes="hint" Text="Tarih gibi sayılar karışmasın diye 5–7 hane önerilir (20240512 sayılmaz)." />
                      <CheckBox Content="Tek dosyalık numaralar için de klasör aç" IsChecked="{Binding SingleFileFolders}"
                                ToolTip.Tip="Kapalıyken numarası başka hiçbir dosyada geçmeyen dosya yerinde kalır (aynı numaralı klasör varsa ona eklenir)." />
                    </StackPanel>
                  </ScrollViewer>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <TextBlock Text="{Binding GroupStatus}" Classes="hint" ToolTip.Tip="{Binding GroupStatusTip}"
                     IsVisible="{Binding GroupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding RootFolder}" Classes="hint" TextWrapping="NoWrap" TextTrimming="PathSegmentEllipsis"
                     ToolTip.Tip="{Binding RootFolder}" IsVisible="{Binding HasRoot}" />
          <TextBlock Text="{Binding TreeMessage}" Classes="hint" Foreground="#E53935"
                     IsVisible="{Binding TreeMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <TextBlock Name="DropHint" DockPanel.Dock="Bottom" Classes="hint drop-hint" Margin="0,6,0,0" IsVisible="False"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="0,6,0,0" IsVisible="{Binding HasRoot}"
                   Text="Taşımak için dosya ya da klasörü sürükleyip bir klasörün üzerine bırakın; boş alana bırakınca ana klasöre taşınır." />
        <Border Name="TreeFrame" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4">
        <ListBox Name="Tree" Classes="tree" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}"
                 DragDrop.AllowDrop="True"
                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FileNode">
              <Border Classes="tree-row" Classes.drop="{Binding IsDropTarget}">
              <Grid ColumnDefinitions="Auto,20,20,*" Background="Transparent" ToolTip.Tip="{Binding FullPath}" Opacity="{Binding RowOpacity}">
                <Border Width="0" Margin="{Binding Indent}" />
                <Button Grid.Column="1" Classes="chevron" IsVisible="{Binding CanExpand}"
                        Command="{Binding $parent[ListBox].((vm:DocumentsViewModel)DataContext).ToggleNodeCommand}"
                        CommandParameter="{Binding}">
                  <Path Data="M 3,1 L 7,5 L 3,9 Z" Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Width="10" Height="10" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                        RenderTransformOrigin="50%,50%">
                    <Path.RenderTransform>
                      <RotateTransform Angle="{Binding ChevronAngle}" />
                    </Path.RenderTransform>
                  </Path>
                </Button>
                <Path Grid.Column="2" IsVisible="{Binding IsDirectory}" Width="16" Height="13" Stretch="Uniform"
                      Data="M 0,2 Q 0,0 2,0 L 6,0 L 8,2 L 14,2 Q 16,2 16,4 L 16,11 Q 16,13 14,13 L 2,13 Q 0,13 0,11 Z" Fill="#E0A82E" VerticalAlignment="Center" />
                <Path Grid.Column="2" IsVisible="{Binding IsFile}" Width="12" Height="15" Stretch="Uniform"
                      Data="M 0,0 L 8,0 L 12,4 L 12,15 L 0,15 Z" Fill="#90A4AE" VerticalAlignment="Center" />
                <Path Grid.Column="2" IsVisible="{Binding IsPdf}" Width="12" Height="15" Stretch="Uniform"
                      Data="M 0,0 L 8,0 L 12,4 L 12,15 L 0,15 Z" Fill="#D32F2F" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding Name}" Margin="5,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Border>
      </DockPanel>
    </Border>

    <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

    <!-- 2. PDF görüntüleyici -->
    <DockPanel Grid.Column="2">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="4,6" IsEnabled="{Binding HasDocument}">
        <Button Name="PrevPage" Classes="small" Content="‹" ToolTip.Tip="Önceki sayfa" />
        <TextBox Name="PageBox" Grid.Column="1" Width="56" Margin="4,0" MinHeight="26" Padding="4,2"
                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Sayfa numarası yazıp Enter'a basın" />
        <TextBlock Name="PageTotal" Grid.Column="2" VerticalAlignment="Center" Opacity="0.7" />
        <Button Name="NextPage" Grid.Column="3" Classes="small" Margin="4,0,0,0" Content="›" ToolTip.Tip="Sonraki sayfa" />
        <Button Name="ZoomOut" Grid.Column="5" Classes="small" Content="−" ToolTip.Tip="Uzaklaştır (Ctrl + tekerlek)" />
        <TextBlock Grid.Column="6" Text="{Binding ZoomText}" Width="50" TextAlignment="Center" VerticalAlignment="Center" />
        <Button Name="ZoomIn" Grid.Column="7" Classes="small" Content="+" ToolTip.Tip="Yakınlaştır (Ctrl + tekerlek)" />
        <ToggleButton Grid.Column="8" Margin="6,0,0,0" Padding="8,3" Content="Sığdır" IsChecked="{Binding FitWidth}" ToolTip.Tip="Sayfayı alan genişliğine sığdır" />
        <ToggleButton Grid.Column="9" Margin="6,0,0,0" Padding="8,3" Content="Vurgula" IsChecked="{Binding ShowHighlights}"
                      ToolTip.Tip="Bulunan numaraları sayfada renklendir (yalnızca ekranda, PDF dosyası değişmez). Sarı: doğrulanmış, turuncu: doğrulanmamış." />
      </Grid>
      <Panel Background="#6B7075">
        <ScrollViewer Name="PdfScroll" Focusable="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible"
                      AllowAutoHide="False">
          <views:PdfPagesView Name="Pages" Document="{Binding Document}" Zoom="{Binding Zoom}" FitWidth="{Binding FitWidth}"
                              Highlights="{Binding Highlights}" ShowHighlights="{Binding ShowHighlights}" HideUnverified="{Binding OnlyValid}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
        <TextBlock Text="{Binding ViewerMessage}" IsVisible="{Binding ShowViewerMessage}" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
      </Panel>
    </DockPanel>

    <GridSplitter Grid.Column="3" Background="Transparent" ResizeDirection="Columns" />

    <!-- 3. Bulunan numaralar -->
    <Border Grid.Column="4" Classes="panel">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding IdentifiersTitle}" Classes="title" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="icon" Content="✕" IsVisible="{Binding IsBulkMode}" Command="{Binding CloseBulkCommand}"
                    ToolTip.Tip="Toplu sonuçları kapat, açık belgenin numaralarına dön" />
          </Grid>
          <Grid ColumnDefinitions="*,6,*">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Tümünü kopyala" Command="{Binding CopyAllCommand}" />
            <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{Binding FindAllText}"
                    Command="{Binding FindAllCommand}"
                    ToolTip.Tip="Seçili klasördeki (alt klasörler dahil) tüm PDF'lerde numara arar" />
          </Grid>
          <CheckBox Content="Yalnızca doğrulananlar" IsChecked="{Binding OnlyValid}"
                    ToolTip.Tip="Kontrol hanesi tutmayanları (telefon, belge numarası vb.) gizler" />
          <TextBlock Text="{Binding ScanStatus}" Classes="hint" />
          <TextBlock Text="{Binding ScanWarning}" Classes="hint" Foreground="#EF6C00" Opacity="1" ToolTip.Tip="{Binding ScanWarningTip}"
                     IsVisible="{Binding ScanWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
          <ContentControl Content="{Binding CustomerQuery}" />
          <ContentControl Content="{Binding IntelQuery}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="0,6,0,0" Text="{Binding IdentifiersHint}" />
        <ListBox Name="Identifiers" Classes="ids" ItemsSource="{Binding VisibleRows}" SelectionMode="Multiple" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:IdentifierRow">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Background="Transparent" ToolTip.Tip="{Binding LocationsTip}">
                <TextBlock Text="{Binding Value}" FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="14" />
                <TextBlock Grid.Column="1" Text="✓" Foreground="#43A047" FontWeight="Bold" IsVisible="{Binding IsValid}" ToolTip.Tip="{Binding ValidityTip}" />
                <TextBlock Grid.Column="1" Text="?" Foreground="#EF6C00" FontWeight="Bold" IsVisible="{Binding !IsValid}" ToolTip.Tip="{Binding ValidityTip}" />
                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,6,*">
                  <TextBlock Text="{Binding KindText}" Classes="hint" FontSize="11" />
                  <TextBlock Grid.Column="2" Text="{Binding PagesText}" Classes="hint" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <GridSplitter Grid.Column="5" Background="Transparent" ResizeDirection="Columns" />

    <!-- 4. Excel'e kaydet -->
    <Border Grid.Column="6" Classes="panel">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
          <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="Excel'e kaydet" Command="{Binding SaveToExcelCommand}" />
          <TextBlock Classes="hint excel-status" Classes.error="{Binding ExcelMessageIsError}" Text="{Binding ExcelMessage}"
                     IsVisible="{Binding ExcelMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <ScrollViewer>
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Excel'e Kaydet" Classes="title" />

            <TextBlock Text="Excel dosyası" Classes="label" />
            <TextBlock Text="{Binding ExcelFileName}" Classes="hint" ToolTip.Tip="{Binding ExcelPath}" Margin="0,0,0,4" />
            <Grid ColumnDefinitions="*,6,*">
              <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Seç..." Command="{Binding ChooseExcelCommand}" />
              <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Yeni..." Command="{Binding NewExcelCommand}" />
            </Grid>


            <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
              <TextBlock Text="Alanlar" Classes="label" Margin="0" VerticalAlignment="Center" />
              <ToggleButton Grid.Column="1" Padding="8,3" Content="Alanları düzenle" IsChecked="{Binding IsEditingFields}"
                            ToolTip.Tip="Alanları aç/kapat, yeniden adlandır, sırala, yeni alan ekle" />
            </Grid>

            <!-- Form -->
            <StackPanel IsVisible="{Binding !IsEditingFields}">
              <TextBlock Classes="hint" Margin="0,6,0,0" IsVisible="{Binding HasNoEnabledFields}"
                         Text="Açık alan yok; kaydedilecek bir şey yok. Alanları açmak ya da eklemek için &quot;Alanları düzenle&quot;ye basın." />
              <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ExcelFieldViewModel">
                    <StackPanel IsVisible="{Binding IsEnabled}">
                      <TextBlock Text="{Binding Name}" Classes="label" IsVisible="{Binding !IsCheckbox}" />
                      <TextBox IsVisible="{Binding IsPdfPath}" IsReadOnly="True" TextWrapping="Wrap" Watermark="Açık PDF yok"
                               Text="{Binding $parent[ItemsControl].((vm:DocumentsViewModel)DataContext).OpenPdfPath, Mode=OneWay}" />
                      <TextBox IsVisible="{Binding IsText}" Text="{Binding Text}" AcceptsReturn="{Binding Multiline}"
                               TextWrapping="Wrap" Classes.multiline="{Binding Multiline}" />
                      <Grid IsVisible="{Binding IsDate}" ColumnDefinitions="*,4,Auto">
                        <TextBox Text="{Binding Text}" Watermark="31.12.2025" />
                        <Button Grid.Column="2" Content="▾" Padding="8,5" ToolTip.Tip="Takvimden seç">
                          <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                              <Calendar SelectedDate="{Binding PickedDate}" SelectedDatesChanged="OnFieldCalendarDateChanged" />
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </Grid>
                      <ComboBox IsVisible="{Binding IsChoice}" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                HorizontalAlignment="Stretch" PlaceholderText="Seçin" />
                      <CheckBox IsVisible="{Binding IsCheckbox}" Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,8,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Alan düzenleyici -->
            <StackPanel IsVisible="{Binding IsEditingFields}">
              <TextBlock Classes="hint" Margin="0,6,0,0"
                         Text="İşaretli alanlar formda görünür ve Excel'e yazılır. PDF yolu silinemez, istemiyorsanız işaretini kaldırın. Değerler, Excel'in ilk satırındaki aynı adlı sütuna yazılır; o adda sütun yoksa sona yeni sütun eklenir." />
              <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ExcelFieldViewModel">
                    <Border Classes="field-editor">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="Auto,*,2,Auto,2,Auto,2,Auto">
                          <CheckBox IsChecked="{Binding IsEnabled}" MinWidth="0" Padding="4,0" ToolTip.Tip="Formda göster ve Excel'e yaz" />
                          <TextBox Grid.Column="1" Text="{Binding Name}" Watermark="Alan adı" />
                          <Button Grid.Column="3" Classes="icon" Content="▲" ToolTip.Tip="Yukarı taşı"
                                  Command="{Binding $parent[ItemsControl].((vm:DocumentsViewModel)DataContext).MoveFieldUpCommand}" CommandParameter="{Binding}" />
                          <Button Grid.Column="5" Classes="icon" Content="▼" ToolTip.Tip="Aşağı taşı"
                                  Command="{Binding $parent[ItemsControl].((vm:DocumentsViewModel)DataContext).MoveFieldDownCommand}" CommandParameter="{Binding}" />
                          <Button Grid.Column="7" Classes="icon" Content="✕" ToolTip.Tip="Alanı sil" IsVisible="{Binding CanRemove}"
                                  Command="{Binding $parent[ItemsControl].((vm:DocumentsViewModel)DataContext).RemoveFieldCommand}" CommandParameter="{Binding}" />
                        </Grid>
                        <TextBlock Text="{Binding NameError}" Classes="hint" Foreground="#E53935" Opacity="1"
                                   IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding KindText}" Classes="hint" />
                        <CheckBox IsVisible="{Binding IsText}" Content="Çok satırlı" IsChecked="{Binding Multiline}" />
                        <TextBox IsVisible="{Binding IsChoice}" Text="{Binding OptionsText}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="60" Watermark="Seçenekler: her satıra bir tane" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,6,Auto" Margin="0,8,0,0">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="+ Alan ekle ▾">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                      <MenuItem Header="Metin" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static vm:ExcelFieldKind.Text}" />
                      <MenuItem Header="Tarih" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static vm:ExcelFieldKind.Date}" />
                      <MenuItem Header="Seçim listesi" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static vm:ExcelFieldKind.Choice}" />
                      <MenuItem Header="Onay kutusu" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static vm:ExcelFieldKind.Checkbox}" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
                <Button Name="ResetFieldsButton" Grid.Column="2" Content="Varsayılan"
                        ToolTip.Tip="Alanları ilk haline döndür (PDF yolu, Belge tarihi, konusu, numarası, Destis numarası, Açıklama)">
                  <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedRight">
                      <StackPanel Width="230" Spacing="8">
                        <TextBlock TextWrapping="Wrap" Text="Alanlar ilk haline dönecek; eklediğiniz alanlar silinir. Excel dosyası değişmez." />
                        <Button Name="ResetFieldsConfirm" HorizontalAlignment="Right" Content="Varsayılana dön" Command="{Binding ResetFieldsCommand}" />
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
