<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WebAutomater.Gui.ViewModels"
        x:Class="WebAutomater.Gui.Views.GroupingPreviewWindow"
        x:DataType="vm:GroupingPreviewViewModel"
        Title="Otomatik gruplama — önizleme"
        Width="760" Height="620" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.folder">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" />
      <TextBlock Text="{Binding RootText}" Classes="hint" TextWrapping="NoWrap" TextTrimming="PathSegmentEllipsis" />
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,8,Auto" Margin="0,10,0,0">
      <Button Name="CancelButton" Grid.Column="1" Content="Vazgeç" IsCancel="True" />
      <Button Name="ApplyButton" Grid.Column="3" Content="{Binding ApplyText}" IsVisible="{Binding HasMoves}" IsDefault="True"
              Background="#1E88E5" Foreground="White" FontWeight="SemiBold" />
    </Grid>

    <ScrollViewer>
      <StackPanel Margin="0,0,12,0">
        <Expander IsVisible="{Binding HasWarnings}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
          <Expander.Header>
            <TextBlock Text="İçi okunamayan dosyalar var: bunlar yalnızca dosya numarasına göre gruplanır" Foreground="#EF6C00" TextWrapping="Wrap" />
          </Expander.Header>
          <ItemsControl ItemsSource="{Binding Warnings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" Classes="hint" Margin="0,1" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>

        <ItemsControl ItemsSource="{Binding Folders}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GroupingPreviewFolder">
              <Border Classes="folder">
                <StackPanel Spacing="3">
                  <Grid ColumnDefinitions="Auto,6,*,Auto">
                    <Path Width="16" Height="13" Stretch="Uniform" VerticalAlignment="Center" Fill="#E0A82E"
                          Data="M 0,2 Q 0,0 2,0 L 6,0 L 8,2 L 14,2 Q 16,2 16,4 L 16,11 Q 16,13 14,13 L 2,13 Q 0,13 0,11 Z" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Border IsVisible="{Binding IsNew}" Background="#1E88E5" CornerRadius="3" Padding="5,0" VerticalAlignment="Center">
                        <TextBlock Text="yeni" FontSize="11" Foreground="White" />
                      </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding CountText}" Classes="hint" VerticalAlignment="Center" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Files}" Margin="22,0,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GroupingPreviewFile">
                        <StackPanel Margin="0,2" ToolTip.Tip="{Binding FullPath}">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" Classes="hint" FontSize="11" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Expander IsVisible="{Binding HasUnchanged}" HorizontalAlignment="Stretch" Header="{Binding UnchangedTitle}">
          <ItemsControl ItemsSource="{Binding Unchanged}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GroupingPreviewFile">
                <StackPanel Margin="0,2" ToolTip.Tip="{Binding FullPath}">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" Classes="hint" FontSize="11" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
