<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WebAutomater.Gui.ViewModels"
        x:Class="WebAutomater.Gui.Views.GroupingPreviewWindow"
        x:DataType="vm:GroupingPreviewViewModel"
        Title="Otomatik gruplama — önizleme"
        Width="760" Height="620" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="ListBox.rows > ListBoxItem">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" />
      <TextBlock Text="{Binding RootText}" Classes="hint" TextWrapping="NoWrap" TextTrimming="PathSegmentEllipsis" />
      <Expander IsVisible="{Binding HasWarnings}" HorizontalAlignment="Stretch" Margin="0,4,0,0">
        <Expander.Header>
          <TextBlock Text="{Binding WarningsTitle}" Foreground="#EF6C00" TextWrapping="Wrap" />
        </Expander.Header>
        <TextBox Text="{Binding WarningsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" FontSize="12" />
      </Expander>
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,8,Auto" Margin="0,10,0,0">
      <Button Name="CancelButton" Grid.Column="1" Content="Vazgeç" IsCancel="True" />
      <Button Name="ApplyButton" Grid.Column="3" Content="{Binding ApplyText}" IsVisible="{Binding HasMoves}" IsDefault="True"
              Background="#1E88E5" Foreground="White" FontWeight="SemiBold" />
    </Grid>

    <!-- Sanallaştırılmış düz liste: yalnızca ekranda görünen satırlar çizilir. -->
    <ListBox Classes="rows" ItemsSource="{Binding Rows}" Background="Transparent" SelectionMode="Single"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:GroupingPreviewRow">
          <Panel ToolTip.Tip="{Binding FullPath}">
            <Grid IsVisible="{Binding IsFolder}" ColumnDefinitions="Auto,6,*,Auto" RowDefinitions="Auto,Auto" Margin="0,8,0,2">
              <Path Grid.RowSpan="2" Width="16" Height="13" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,0,0" Fill="#E0A82E"
                    Data="M 0,2 Q 0,0 2,0 L 6,0 L 8,2 L 14,2 Q 16,2 16,4 L 16,11 Q 16,13 14,13 L 2,13 Q 0,13 0,11 Z" />
              <TextBlock Grid.Column="2" Text="{Binding Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <Border Grid.Column="3" IsVisible="{Binding HasBadge}" Background="#1E88E5" CornerRadius="3" Padding="5,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="White" />
              </Border>
              <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding Detail}" Classes="hint" FontSize="11" />
            </Grid>
            <StackPanel IsVisible="{Binding IsLabel}" Orientation="Horizontal" Spacing="6" Margin="22,1,0,1">
              <Border Background="#43A047" CornerRadius="3" Padding="5,0" VerticalAlignment="Center">
                <TextBlock Text="etiket" FontSize="11" Foreground="White" />
              </Border>
              <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Detail}" Classes="hint" FontSize="11" VerticalAlignment="Center" TextWrapping="NoWrap" />
            </StackPanel>
            <StackPanel IsVisible="{Binding IsFile}" Margin="22,1,0,1">
              <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Detail}" Classes="hint" FontSize="11" IsVisible="{Binding HasDetail}" />
            </StackPanel>
            <TextBlock IsVisible="{Binding IsSection}" Text="{Binding Text}" FontWeight="SemiBold" Margin="0,14,0,2" Opacity="0.8" />
          </Panel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
